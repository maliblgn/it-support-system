APP_ENVIRONMENT=development
APP_APP_NAME=Destek Takip API
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_LOG_FILE=data/logs/application.jsonl
APP_LOG_MAX_BYTES=10485760
APP_LOG_BACKUP_COUNT=5

APP_DATABASE_SERVER=localhost
APP_DATABASE_PORT=1433
APP_DATABASE_NAME=DestekTakip
APP_DATABASE_DRIVER=ODBC Driver 18 for SQL Server
APP_DATABASE_TRUSTED_CONNECTION=true
APP_DATABASE_USERNAME=
APP_DATABASE_PASSWORD=
APP_DATABASE_ENCRYPT=true
APP_DATABASE_TRUST_SERVER_CERTIFICATE=false
APP_DATABASE_CONNECTION_TIMEOUT_SECONDS=5
APP_DATABASE_POOL_SIZE=5
APP_DATABASE_MAX_OVERFLOW=10

# Test veya özel kurulumlar için tam SQLAlchemy URL'si verilebilir.
# Verildiğinde yukarıdaki parçalardan üretilen MSSQL URL'sinin yerini alır.
APP_DATABASE_URL=

APP_API_PREFIX=/api
APP_CORS_ORIGINS=["http://localhost:5173"]
APP_ALLOWED_EMAIL_DOMAINS=["example.com"]
APP_PUBLIC_REGISTRATION_ENABLED=true
APP_DEMO_MODE=false
APP_DEMO_PROTECTED_EMAILS=[]

# Production ortamında en az 32 karakterlik rastgele bir değer kullanın.
APP_SESSION_SECRET=development-only-change-this-session-secret-before-production
APP_SESSION_LIFETIME_HOURS=8
APP_SESSION_COOKIE_NAME=it_ticket_session
APP_CSRF_COOKIE_NAME=it_ticket_csrf
# Tanımlanmazsa production'da true, diğer ortamlarda false olur.
# APP_SESSION_COOKIE_SECURE=true

APP_PASSWORD_SCRYPT_N=16384
APP_PASSWORD_SCRYPT_R=8
APP_PASSWORD_SCRYPT_P=1

APP_UPLOAD_ROOT=data/uploads
APP_MAX_ATTACHMENT_SIZE_MB=10
APP_MAX_ATTACHMENTS_PER_TICKET=5

# Sistem içi bildirimler bu ayardan bağımsızdır. SMTP teslimi isteniyorsa true yapın.
APP_EMAIL_DELIVERY_ENABLED=false
APP_SMTP_HOST=
APP_SMTP_PORT=587
APP_SMTP_USERNAME=
APP_SMTP_PASSWORD=
APP_SMTP_USE_TLS=true
APP_SMTP_TIMEOUT_SECONDS=10
APP_MAIL_FROM=
# Bu liste boşsa aktif IT hesaplarının e-posta adresleri kullanılır.
APP_IT_NOTIFICATION_RECIPIENTS=[]
